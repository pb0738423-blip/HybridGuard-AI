# HybridGuard AI Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8000
MAX_PAYLOAD_SIZE_MB=10
REQUEST_TIMEOUT_SECONDS=30

# Model Paths & Calibration
MODEL_ARTIFACTS_DIR=models/artifacts
EVALUATION_DIR=models/evaluation
UNCERTAINTY_THRESHOLD=0.65
UNCERTAINTY_MARGIN=0.15

# Fact Checking Search Provider (wikipedia, duckduckgo, mock)
SEARCH_PROVIDER=wikipedia
USER_AGENT=HybridGuardAI/1.0 (academic-research-fact-check)

# Optional LLM integration (fallback to local rule-based if empty)
GEMINI_API_KEY=

